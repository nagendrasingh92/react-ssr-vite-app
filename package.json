{
  "name": "react-ssr-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server.js",
    "build": "vite build && vite build --ssr src/server/main.tsx",
    "start": "cross-env NODE_ENV=production node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.26.0"
  },
  "optionalDependencies": {
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/express": "^5.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.2.2",
    "vite": "^6.3.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
